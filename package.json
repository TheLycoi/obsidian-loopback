{
  "name": "obsidian-loopback",
  "version": "0.1.0",
  "description": "Capture a passage and its source into a flashcard inbox, no network call.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:build": "esbuild capture-format.ts --bundle --platform=node --format=cjs --outfile=.test-build/capture-format.cjs",
    "test": "npm run test:build && node test/capture-format.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "obsidian": "^1.4.11",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
